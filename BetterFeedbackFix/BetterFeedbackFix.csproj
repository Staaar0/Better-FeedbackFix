<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Required so CounterStrikeSharp can load the plugin and copy dependencies. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>BetterFeedbackFix</AssemblyName>
    <RootNamespace>BetterFeedbackFix</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin this to the CounterStrikeSharp.API version that matches the
         CounterStrikeSharp build installed on your server. Check the version in
         addons/counterstrikesharp/ and set it here (e.g. 1.0.305). -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.369">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
